# Copy to .env and set real values. Never commit .env.
PORT=3000
NODE_ENV=development
DATABASE_PATH=./data/hrms.sqlite
# Generate a random secret of at least 32 characters for local development.
# Use a secret manager in production.
JWT_SECRET=
# Comma-separated browser origins; do not use * in production.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Business timezone controls the attendance day. Example: Asia/Kuala_Lumpur
BUSINESS_TIME_ZONE=UTC
# Trusted office network CIDR ranges. Wi-Fi clocking checks the direct
# network peer address; do not trust a client-supplied SSID or X-Forwarded-For.
HRMS_ALLOWED_WIFI_CIDRS=
# Optional geofence. All three values must be set to enable location clocking.
HRMS_GEOFENCE_LATITUDE=
HRMS_GEOFENCE_LONGITUDE=
HRMS_GEOFENCE_RADIUS_METERS=
# Bootstrap one initial account with `npm run bootstrap-user`.
HRMS_BOOTSTRAP_EMAIL=
HRMS_BOOTSTRAP_NAME=
HRMS_BOOTSTRAP_PASSWORD=
